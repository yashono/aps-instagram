# Meta / Instagram Messaging
VERIFY_TOKEN=your_random_verify_token
APP_SECRET=your_meta_app_secret
PAGE_ACCESS_TOKEN=your_long_lived_page_access_token

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Server / persistence
PORT=3000
DATABASE_PATH=./data/bot.db

# Public HTTPS base URL (optional; Railway sets RAILWAY_PUBLIC_DOMAIN automatically)
# PUBLIC_BASE_URL=https://aps-instagram-production.up.railway.app

# Instagram professional account ID from Meta API setup (used for native PDF attachments)
# INSTAGRAM_USER_ID=17841477504090912

# Optional: skip signature check only for local testing (never in production)
# SKIP_SIGNATURE_VERIFICATION=true
